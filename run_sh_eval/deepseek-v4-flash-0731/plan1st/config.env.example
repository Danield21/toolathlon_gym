# Copy to config.env (gitignored), then fill in your own endpoint and credentials.
API_BASE_URL=""
API_KEY=""
# Wire format, not an account/provider name: openai or anthropic.
API_FORMAT="openai"
# The official legacy ID now routes to V4.1 Flash, not a pinned 0731 snapshot.
# API model ID; override only if your endpoint requires a different deployment ID.
MODEL_NAME="deepseek-v4-flash"

# Evaluation sampling defaults; empty = model default.
TEMPERATURE=""
TOP_P=""
REASONING_EFFORT="high"
ENABLE_THINKING=0
BREAK_SCHEMA_CYCLES=0
MAX_OUTPUT_TOKENS=0
MAX_CONTEXT=262144
MAX_STEPS=100
TASK_TIMEOUT_S=7200
MAX_CONCURRENT=1
PG_PORT_BASE=25432

# Use absolute paths when overriding. Defaults resolve from this directory.
# PROJECT_ROOT="/path/to/toolathlon_gym"
# RUNTIME_ROOT="/path/to/toolathlon_gym_eval_dockers"
# AGENT_SQSH="/path/to/toolathlon-pack.sqsh"
# AGENT_TEMPLATE="/path/to/unpacked/toolathlon-pack"  # optional; copies per case
# KIMI_DIST="/path/to/kimi-code"                    # contains dist/main.mjs
# ORACLE_TASK_DIR="/path/to/metrics_eval_bw/oracle166"  # oracle only
# OUTPUT_ROOT="/path/to/results"
# ENROOT_INSTALL_ROOT="/path/to/enroot"           # optional user-space install (bin/lib/etc)
# PYTHON_BIN="python3"
# PATH="/path/to/postgresql/bin:/path/to/enroot/bin:$PATH"
# HTTPS_PROXY=""  # optional; used only by the local API gateway
