# Copy to config.env (Git-ignored), then set API_BASE_URL and API_KEY.
# API_BASE_URL is the API base, without /chat/completions or /messages.
API_BASE_URL=""
API_KEY=""
# openai (OpenAI-compatible API) or anthropic (Messages API).
API_FORMAT="openai"
# API model ID; change it only if your endpoint uses a different ID.
MODEL_NAME="glm-5.3"

# Request settings used in the paper; empty = model default.
# ENABLE_THINKING=1 adds enable_thinking to requests; BREAK_SCHEMA_CYCLES=1 removes
# recursive references from tool schemas; MAX_OUTPUT_TOKENS=0 means no cap.
TEMPERATURE="1"
TOP_P="0.95"
REASONING_EFFORT="max"
ENABLE_THINKING=0
BREAK_SCHEMA_CYCLES=1
MAX_OUTPUT_TOKENS=0

# Per-task limits and the number of tasks run in parallel.
MAX_CONTEXT=262144
MAX_STEPS=100
TASK_TIMEOUT_S=7200
MAX_CONCURRENT=1
# Enroot only: first port of the per-task PostgreSQL servers.
PG_PORT_BASE=25432

# Optional, both backends.
# OUTPUT_ROOT="/path/to/results"
# HTTPS_PROXY=""  # used only by the local API gateway
# PYTHON_BIN="python3"

# Optional Enroot overrides; absolute paths. Defaults resolve from this checkout.
# PROJECT_ROOT="/path/to/toolathlon_gym"
# RUNTIME_ROOT="/path/to/MS-Eval/.local/enroot"
# AGENT_SQSH="/path/to/MS-Eval/.local/enroot/images/toolathlon-pack.sqsh"
# AGENT_TEMPLATE="/path/to/unpacked/toolathlon-pack"  # optional; copied per task
# KIMI_DIST="/path/to/MS-Eval/.local/enroot/kimi_dist/kimi-code"  # contains dist/main.mjs
# ORACLE_TASK_DIR="/path/to/MS-Eval/data/oracle166"  # oracle only
# ENROOT_INSTALL_ROOT="/path/to/enroot"  # optional user-space install (bin, lib, etc)
# PATH="/path/to/postgresql/bin:/path/to/enroot/bin:$PATH"
