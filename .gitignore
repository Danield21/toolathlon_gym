# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Node
node_modules/

# Runtime outputs
dumps/
_test_workspace/
logs/

# Local eval secrets / API keys (incl. per-run config.<name>.env with live
# relay keys / internal URLs — keep these local-only)
run_sh/**/config.env
run_sh/**/config.*.env
run_sh/**/.env
*.secret

# Eval launcher logs / Slurm artifacts (keep scripts, ignore runtime)
run_sh/**/logs/
run_sh/**/*.log
run_sh/**/*.out
run_sh/**/*.err
run_sh/**/*.pid
run_sh/**/*.bak*

# Built MCP entrypoints that are regenerated in the Enroot image
# (source of truth is src/; template dist is under toolathlon_gym_eval_dockers)
local_servers/woocommerce-mcp/dist/index.js

# OS
.DS_Store
